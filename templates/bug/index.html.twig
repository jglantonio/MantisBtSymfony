{% extends 'logged.html.twig' %}

{% block title %}Gestión de Incidencias{% endblock %}
{% block titles %}Listado de inidencias{% endblock %}
{% block subtitle %}Mantisbt > Incidencias > Listado de inidencias{% endblock %}
{% block headerbuttons %}
    <a href="/bug/create" class="btn btn-primary">Listado de inidencias</a>
{% endblock %}

{% block stylesheets %}
{% endblock %}

        {% block body %}
            {# TABLA DE INCIDENCIAS #}
<section class="table-section">
    <table class="incidents-table">
        <thead>
        <tr>
            <th>#ID</th>
            <th>Resumen</th>
            <th>Proyecto</th>
            <th>Reportador</th>
            <th>Prioridad</th>
            <th>Estado</th>
            <th>Asignado a</th>
            <th>Últ. Actualización</th>
            <th>Fecha creación</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for bug in incidencias %}
            <tr class="incident-row">
                <td class="incident-id">#{{ bug.id }}</td>
                <td class="incident-summary">{{ bug.getSummary() }}</td>
                <td class="incident-project">{{ bug.getProject().getName() }}</td>
                <td class="incident-project">{{ bug.getReporter.getUsername() }}</td>
                <td>
                       <span class="tag tag-{{ bug.getPriority() | lower }}">{{ bug.getPriorityName() ?? '-' }}</span>
                </td>
                <td>
                    <span class="status status--{{ bug.getStatus()|lower }}">
                        {{ bug.getStatus() }}
                    </span>
                </td>
                <td class="incident-assignee">{{ bug.getHandler().getUsername() }}</td>
                <td class="">{{ bug.lastUpdated ?? '—' }}</td>
                <td class="">{{ bug.dateSubmitted ?? '—' }}</td>
                <td>
                    <a href="/bug/edit/{{bug.id}}" class="btn btn-primary">Editar</a>
                    <a href="/bug/show/{{bug.id}}" class="btn btn-primary">Ver</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endblock %}
