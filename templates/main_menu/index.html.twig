{% extends 'logged.html.twig' %}

{% block title %}Gestión de Incidencias{% endblock %}
{% block titles %}Gestión de Incidencias{% endblock %}
{% block subtitle %}Mantisbt > Main menu{% endblock %}
{% block headerbuttons %}
    <a href="/bug/create" class="btn btn-primary">Crear incidencia</a>
{% endblock %}

{% block stylesheets %}
{% endblock %}

        {% block body %}
            {# TABLA DE INCIDENCIAS #}
            <section class="table-section">
                <table class="incidents-table">
                    <thead>
                    <tr>
                        <th>#ID</th>
                        <th>Resumen</th>
                        <th>Proyecto</th>
                        <th>Reportador</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Asignado a</th>
                        <th>Últ. Actualización</th>
                        <th>Fecha creación</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                        {% for bug in incidencias %}
                            <tr class="incident-row">
                                <td class="incident-id">#{{ bug.id }}</td>
                                <td class="incident-summary">{{ bug.summary }}</td>
                                <td class="incident-project">{{ bug.project.name }}</td>
                                <td class="incident-project">{{ bug.reporter.username }}</td>
                                <td>
                                    <span class="badge badge--{{ bug.priority|lower }}">
                                        {{ bug.priority }}
                                    </span>
                                </td>
                                <td>
                                    <span class="status status--{{ bug.status|lower }}">
                                        {{ bug.status }}
                                    </span>
                                </td>
                                <td class="incident-assignee">{{ bug.handler.name ?? '—' }}</td>
                                <td class="">{{ bug.lastUpdated ?? '—' }}</td>
                                <td class="">{{ bug.dateSubmitted ?? '—' }}</td>
                                <td>
                                    <a href="/bug/edit" class="btn btn-primary">Editar</a>
                                    <a href="/bug/show" class="btn btn-primary">Ver</a>
                                </td>
                            </tr>
                    {% endfor %}
                    </tbody>
                </table>
{% endblock %}
