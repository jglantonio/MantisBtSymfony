<!DOCTYPE html>
<html data-bs-theme="light">
    <head>
        <script>
            // Aplica el tema guardado antes de pintar para evitar parpadeo
            (function () {
                var t = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-bs-theme', t);
            })();
        </script>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('css/bootstrap.css') }}">
        <link rel="stylesheet" href="{{ asset('css/incidencias.css') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
              crossorigin="anonymous" referrerpolicy="no-referrer">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
    <div class="dashboard">

        {# SIDEBAR #}
        <aside class="sidebar">
            <div class="sidebar__logo">
                <span class="logo-icon"><i class="fa-solid fa-bug"></i></span>
                <span class="logo-text">BugDesk</span>
            </div>
            <nav class="sidebar__nav">
                <a href="/bug" class="nav-item nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-bug"></i></span> Incidencias
                </a>
                <a href="/project" class="nav-item disabled">
                    <span class="nav-icon"><i class="fa-solid fa-folder"></i></span> Proyectos
                </a>
                {#<a href="#" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-file"></i></span> Informes
                </a> #}

                <a href="/tags" class="nav-item disabled">
                    <span class="nav-icon"><i class="fa-solid fa-tag"></i></span> Etiquetas
                </a>
                <a href="/category" class="nav-item nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-tags"></i></span> Categorias
                </a>{#
                <a href="#" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-gear"></i></span> Configuración
                </a> #}
                <a href="/user" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-users"></i></span> Usuarios
                </a>
                <a href="/config" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-sliders"></i></span> Configuración
                </a>
                <button type="button" id="theme-toggle" class="nav-item" style="background:none;border:none;width:100%;text-align:left;cursor:pointer;font:inherit;">
                    <span class="nav-icon"><i class="fa-solid fa-moon"></i></span> <span id="theme-toggle-label">Tema oscuro</span>
                </button>
            </nav>

            <div class="sidebar__user">
                <a href="/profile" class="nav-item m-0 p-0 flex-grow-1" >
                    <div class="user-avatar">{{ app.user ? app.user.username|first|upper : 'A' }}</div>
                    <div class="user-info">
                        <span class="user-name">{{ app.user ? app.user.username : 'Admin' }}</span>
                        <span class="user-role">Administrador</span>
                    </div>
                </a>
                <a href="{{ path('app_logout') }}" class="logout-btn" title="Cerrar sesión">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </aside>

        {# MAIN CONTENT #}
        <main class="main">

            {# HEADER #}
            <header class="main__header">
                <div class="header-left">
                    <h1 class="page-title">{%block titles%}{% endblock %}</h1>
                    <span class="page-subtitle">{%block subtitle%}{% endblock %}</span>
                </div>
                <div class="header-right">
                    {% block headerbuttons %}{% endblock %}
                </div>
            </header>

        {% block body %}{% endblock %}
        </main>
    </div>

    <script>
        (function () {
            var btn = document.getElementById('theme-toggle');
            if (!btn) return;
            var icon = btn.querySelector('i');
            var label = document.getElementById('theme-toggle-label');

            function sync() {
                var dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                icon.className = dark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
                label.textContent = dark ? 'Tema claro' : 'Tema oscuro';
            }
            sync();

            btn.addEventListener('click', function () {
                var next = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', next);
                localStorage.setItem('theme', next);
                sync();
            });


        })();

        // Sidebar colapsable: click en el logo alterna "solo iconos";
        // en ventanas pequeñas se fuerza el modo iconos.
        (function () {
            var dashboard = document.querySelector('.dashboard');
            var logo = document.querySelector('.sidebar__logo');
            if (!dashboard) return;

            var MOBILE = 768;

            function apply(collapsed) {
                dashboard.classList.toggle('sidebar-collapsed', collapsed);
            }
            function savedPref() {
                return localStorage.getItem('sidebar') === '1';
            }
            function syncToViewport() {
                if (window.innerWidth <= MOBILE) {
                    apply(true);          // ventana pequeña -> solo iconos
                } else {
                    apply(savedPref());   // restaura la preferencia del usuario
                }
            }

            syncToViewport();
            window.addEventListener('resize', syncToViewport);

            if (logo) {
                logo.title = 'Plegar / desplegar menú';
                logo.addEventListener('click', function () {
                    var collapsed = !dashboard.classList.contains('sidebar-collapsed');
                    apply(collapsed);
                    localStorage.setItem('sidebar', collapsed ? '1' : '0');
                });
            }
        })();
    </script>
    </body>
</html>
