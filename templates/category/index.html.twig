
{% extends 'logged.html.twig' %}

{% block title %}Category index{% endblock %}
{% block titles %}Category index{% endblock %}
{% block subtitle %}Mantisbt > Category list{% endblock %}
{% block headerbuttons %}
    <a href="/category/new" class="btn btn-primary" title="Crear categoria"><i class="fa-solid fa-plus"></i></a>
{% endblock %}

{% block body %}

    <section class="table-section">
        <table class="incidents-table">
        <thead>
                <tr>
                    <th>Id</th>
                    <th>ProjectId</th>
                    <th>UserId</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>actions</th>
                </tr>
                </thead>
                <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>{{ category.getProject().getName() }}</td>
                        <td>{{ category.getUser().getUserName() }}</td>
                        <td>{{ category.name }}</td>
                        <td>{{ category.status ==1 ? 'Activo' : "Deprecated"}}</td>
                        <td>
                            <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-primary" title="Ver"><i class="fa-solid fa-eye"></i></a>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-primary" title="Editar"><i class="fa-solid fa-edit"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
    </section>

{% endblock %}
