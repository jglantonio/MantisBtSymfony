{% extends 'logged.html.twig' %}

{% block title %}Gestión de Incidencias{% endblock %}
{% block titles %}Listado de Proyectos{% endblock %}
{% block subtitle %}Mantisbt > Proyectos > Listado de proeyectos{% endblock %}
{% block headerbuttons %}
    <a href="/bug/create" class="btn btn-primary">Crear proyecto</a>
{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block body %}
    <h1>Listado de proyectos</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Estado</th>
                <th>Habiliado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.id }}</td>
                <td>{{ project.name }}</td>
                <td>{{ project.getStatusName }}</td>
                <td><span class="{{ project.getStatusName?"fa fa-check":"fa fa-plus" }}"></span></td>
                <td>
                    <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-primary" title="Ver">show</a>
                    <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-primary" title="Editar">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_project_new') }}">Create new</a>
{% endblock %}
