{% extends 'logged.html.twig' %}

{% block title %}Gestión de Incidencias{% endblock %}
{% block titles %}Listado de Proyectos{% endblock %}
{% block subtitle %}Mantisbt > Proyectos > Listado de proeyectos{% endblock %}
{% block headerbuttons %}
    <a href="/bug/create" class="btn btn-primary">Crear proyecto</a>
{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block body %}
    <h1>Project</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ project.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ project.name }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ project.status }}</td>
            </tr>
            <tr>
                <th>Enabled</th>
                <td>{{ project.enabled }}</td>
            </tr>
            <tr>
                <th>ViewState</th>
                <td>{{ project.viewState }}</td>
            </tr>
            <tr>
                <th>AccessMin</th>
                <td>{{ project.accessMin }}</td>
            </tr>
            <tr>
                <th>FilePath</th>
                <td>{{ project.filePath }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ project.description }}</td>
            </tr>
            <tr>
                <th>CategoryId</th>
                <td>{{ project.categoryId }}</td>
            </tr>
            <tr>
                <th>InheritGobal</th>
                <td>{{ project.inheritGobal }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_project_index') }}" class="btn btn--primary">back to list</a>

    <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-secondary">edit</a>
{% endblock %}
